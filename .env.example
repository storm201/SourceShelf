# ============================================================================
#  Copy this file to ".env" and fill in your Supabase project details.
#    cp .env.example .env
#
#  The .env file is git-ignored — never commit it.
#  Everything here is optional: with no .env the site still builds and runs,
#  it just keeps discovery history in data/apps.json instead of Supabase.
# ============================================================================

# ---- Supabase (Project Settings → Data API) --------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
#   ^ bare origin only. Do NOT paste the ".../rest/v1/" form that the
#     dashboard's Copy button gives you — this file wants just the host.
#     (Trailing /rest/v1/ is tolerated now, but this is the clean form.)

# Safe to publish. Read-only because Row Level Security allows SELECT only.
SUPABASE_ANON_KEY=

# SECRET — bypasses RLS, so the crawler can write. Local use only.
# In GitHub Actions this goes in Secrets, never in the repo.
SUPABASE_SERVICE_KEY=

# ---- Optional --------------------------------------------------------------
# Bigger GitHub API budget (5,000/hr instead of 60). No scopes needed.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# Used in the RSS feed's <link>. Set this once Pages is live.
# SITE_URL=https://yourname.github.io/sourceshelf
